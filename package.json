{
  "name": "f1-overview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc && vite build && node scripts/generate-seo-artifacts.mjs && node scripts/prerender-engineering.mjs && node scripts/prune-legacy-showroom-assets.mjs && node scripts/check-commercial-visual-isolation.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "results-engine": "node --experimental-strip-types src/results-engine/cli.ts",
    "results-engine:shadow": "node --experimental-strip-types src/results-engine/shadow-cli.ts",
    "results-engine:observe": "node --experimental-strip-types src/results-engine/observe-cli.ts",
    "sync:2026": "node scripts/update-2026-data.js",
    "sync:sessions": "node scripts/sync-openf1-sessions.js",
    "asset:eds-g01": "node scripts/generate-eds-g01.mjs",
    "asset:eds-g01:images": "node scripts/generate-eds-showroom-assets.mjs",
    "asset:eds-visuals": "node scripts/generate-eds-visual-assets.mjs",
    "asset:eds-editorial": "node scripts/generate-eds-editorial-assets.mjs",
    "asset:eds-engineering": "node scripts/generate-eds-engineering-assets.mjs",
    "asset:eds-engineering:check": "node scripts/generate-eds-engineering-assets.mjs --check",
    "asset:eds-engineering:social": "node scripts/generate-eds-engineering-social-cards.mjs",
    "asset:eds-engineering:social:check": "node scripts/generate-eds-engineering-social-cards.mjs --check",
    "seo:generate": "node scripts/generate-seo-artifacts.mjs",
    "asset:eds-g01:validate": "node scripts/validate-eds-g01.mjs",
    "asset:eds-g02": "node scripts/generate-eds-g02.mjs",
    "asset:eds-g02:validate": "node scripts/validate-eds-g02.mjs",
    "asset:eds-g03": "node scripts/generate-eds-g03.mjs",
    "asset:eds-g03:validate": "node scripts/validate-eds-g03.mjs",
    "qa:r2:model-review": "node scripts/capture-r2-model-review.mjs",
    "qa:r2:legacy-skins": "node scripts/capture-r2-legacy-skin-review.mjs",
    "qa:r3:blockout": "node scripts/capture-r3-g03-blockout.mjs",
    "qa:showroom:browser": "node scripts/capture-showroom-evidence.mjs",
    "qa:m3:visuals": "node scripts/qa-m3-visual-assets.mjs",
    "qa:m3:comparison": "node scripts/capture-m3-phase2-comparison.mjs",
    "qa:m5:seo": "node scripts/qa-m5-seo.mjs",
    "qa:m5:browser": "node scripts/capture-m5-engineering-evidence.mjs",
    "qa:m5:accessibility": "node scripts/qa-m5-accessibility.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.108.4",
    "@react-three/fiber": "^8.16.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.3.0",
    "three": "^0.165.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.39",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
